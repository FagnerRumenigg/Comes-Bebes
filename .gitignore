# Operating systems and editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml
*.ipr
*.iws

# Environment variables and secrets
.env
.env.*
!**/.env.example
!frontend/.env.e2e
!frontend/.env.test

# Logs and JVM crash dumps
*.log
hs_err_pid*
replay_pid*

# Frontend dependencies and generated artifacts
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
frontend/blob-report/
frontend/.vite/
frontend/*.tsbuildinfo
frontend/*.local

# Local design references
frontend/docs/design/

# Internal development documentation
/docs/
/backend/docs/
/frontend/docs/

# Backend build artifacts
backend/target/

# Python environments and caches
backend/.venv*/
backend/**/__pycache__/
backend/**/*.py[cod]
backend/.pytest_cache/

# Validator models, datasets, and generated images
backend/validator/models/
backend/validator/normalized/
backend/validator/data/*
!backend/validator/data/README.md

# Runtime uploads
backend/uploads/

# Application infrastructure runtime data
infra/.env
infra/.env.*
!infra/.env.example

# Terraform local state/cache — o state do bootstrap fica local de propósito
# (é ele quem cria o backend remoto do módulo principal); nunca commitar
# state, já que pode conter dados sensíveis (ex.: chaves de storage account).
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*.tfvars
*.tfvars.json
!*.tfvars.example
