# PostgreSQL
SHARED_DB_HOST=host.docker.internal
SHARED_DB_PORT=5432
SHARED_DB_USERNAME=comesebebes_user
SHARED_DB_PASSWORD=substitua-por-uma-senha-segura
COMESEBEBES_DB_NAME=comesebebes

# Backend
COMESEBEBES_SERVER_PORT=8082
COMESEBEBES_IMAGE_STORAGE_PATH=./uploads/images
COMESEBEBES_IMAGE_VALIDATOR_URL=http://localhost:8001
COMESEBEBES_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Security
# Use valores aleatorios diferentes em cada ambiente. O JWT_SECRET precisa ter pelo menos 32 bytes.
JWT_SECRET=substitua-por-uma-chave-jwt-aleatoria-com-no-minimo-32-bytes
USER_BLOCKED_USERNAME_HMAC_SECRET=substitua-por-uma-chave-hmac-aleatoria

# Optional settings
COMESEBEBES_JWT_ISSUER=comesebebes
COMESEBEBES_JWT_EXPIRATION_MINUTES=60
COMESEBEBES_REFRESH_TOKEN_EXPIRATION_DAYS=30
COMESEBEBES_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
COMESEBEBES_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
COMESEBEBES_PUBLICATION_RATE_LIMIT_MAX_ATTEMPTS=3
COMESEBEBES_PUBLICATION_RATE_LIMIT_WINDOW_SECONDS=600
