# Banco exclusivo da aplicação
DB_HOST=platform-postgres
DB_PORT=5432
DB_HOST_PORT=5432
DB_NAME=comesebebes
DB_USERNAME=comesebebes_app
DB_PASSWORD=SUBSTITUA_PELA_SENHA_PROVISIONADA
# Parâmetros extras da URL JDBC. Vazio localmente; em bancos gerenciados que
# exigem SSL (ex.: Azure Database for PostgreSQL Flexible Server), usar
# DB_URL_PARAMS=?sslmode=require
DB_URL_PARAMS=

# Porta local opcional da API; o gateway usa a porta interna 8082
API_HOST_PORT=8082

# Segurança: gere valores aleatórios diferentes por ambiente
JWT_SECRET=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_DE_PELO_MENOS_32_BYTES
USER_BLOCKED_USERNAME_HMAC_SECRET=SUBSTITUA_POR_OUTRA_CHAVE_ALEATORIA

# Aplicação
# Armazenamento de imagem: "local" (padrão, filesystem) ou "blob" (Azure Blob
# Storage via Managed Identity - sem chave guardada). Os dois COMESEBEBES_STORAGE_BLOB_*
# só importam quando COMESEBEBES_STORAGE_TYPE=blob.
COMESEBEBES_STORAGE_TYPE=local
COMESEBEBES_STORAGE_BLOB_ACCOUNT_URL=
COMESEBEBES_STORAGE_BLOB_CONTAINER=comesebebes-images
COMESEBEBES_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://fagnerrumenigg.github.io
# ID do relying party WebAuthn: precisa ser igual ao domínio do frontend (sem protocolo/porta),
# senão o navegador recusa o registro de biometria com "relying party ID is not a registrable
# domain suffix of ... the current domain".
COMESEBEBES_WEBAUTHN_RP_ID=fagnerrumenigg.github.io
COMESEBEBES_JWT_ISSUER=comesebebes
COMESEBEBES_JWT_EXPIRATION_MINUTES=60
COMESEBEBES_REFRESH_TOKEN_EXPIRATION_DAYS=30
COMESEBEBES_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
COMESEBEBES_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
COMESEBEBES_PUBLICATION_RATE_LIMIT_MAX_ATTEMPTS=3
COMESEBEBES_PUBLICATION_RATE_LIMIT_WINDOW_SECONDS=600
COMESEBEBES_PASSWORD_RESET_RATE_LIMIT_MAX_ATTEMPTS=5
COMESEBEBES_PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=900

# Origem do frontend, usada só para montar o link de "esqueci minha senha"
# que vai por e-mail (docs/telas/11-recuperar-senha.html).
COMESEBEBES_FRONTEND_URL=http://localhost:5173

# E-mail: "log" (padrão local, só loga, sem precisar de credencial) ou
# "azure" (Azure Communication Services Email — mesmo recurso do
# Entertain-Me). Os dois COMESEBEBES_EMAIL_AZURE_* só importam quando
# COMESEBEBES_EMAIL_DELIVERY_MODE=azure.
COMESEBEBES_EMAIL_DELIVERY_MODE=log
COMESEBEBES_EMAIL_SENDER_ADDRESS=noreply@comesebebes.com
COMESEBEBES_EMAIL_AZURE_ENDPOINT=
COMESEBEBES_EMAIL_AZURE_ACCESS_KEY=
