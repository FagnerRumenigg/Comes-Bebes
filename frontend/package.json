{
  "name": "comes-e-bebes-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "npm run typecheck && node ./node_modules/vite/bin/vite.js build",
    "typecheck": "node ./node_modules/vue-tsc/bin/vue-tsc.js --noEmit -p tsconfig.app.json",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "format": "node ./node_modules/prettier/bin/prettier.cjs --write .",
    "format:check": "node ./node_modules/prettier/bin/prettier.cjs --check .",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:unit": "node ./node_modules/vitest/vitest.mjs run",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test",
    "api:generate": "node ./node_modules/orval/dist/bin/orval.js --config orval.config.ts",
    "api:check": "node ./scripts/check-generated.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/libre-caslon-text": "5.3.0",
    "@tanstack/vue-query": "5.101.4",
    "axios": "1.19.0",
    "pinia": "4.0.2",
    "vue": "3.5.41",
    "vue-router": "4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.3.0",
    "@playwright/test": "1.62.1",
    "@types/node": "22.19.15",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.9.0",
    "jsdom": "27.2.0",
    "msw": "2.12.7",
    "orval": "7.21.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9"
  },
  "overrides": {
    "js-yaml": "4.3.1",
    "lodash": "4.18.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
